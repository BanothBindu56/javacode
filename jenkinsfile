pipeline
{
   agent any
       stages
       {
           stage('clone')
           {
               steps
               {
                   git branch:'devopscsec',url:'https://github.com/BanothBindu56/javacode.git'
               }
           }
           stage('build')
           {
               steps
               {
                   sh 'javac Hello.java'
               }
           }
           stage('run')
           {
               steps
               {
                   sh 'java Hello'
               }
           }
       }
}
